# Turso remote-only libSQL connection.
# Example: libsql://your-database-org.turso.io
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Upstash Redis REST connection.
# Example: https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Core proxy server.
TOKENGUARD_LISTEN_ADDR=:8080
TOKENGUARD_UPSTREAM_URL=https://api.openai.com
TOKENGUARD_DEFAULT_PROVIDER=openai
# Comma-separated provider=url routes. Any OpenAI-compatible provider can be added here.
# Example: openai=https://api.openai.com,anthropic=https://api.anthropic.com,openrouter=https://openrouter.ai/api
# Note: for OpenRouter use https://openrouter.ai/api (NOT .../api/v1). Clients call /v1/chat/completions on TokenGuard;
# the proxy joins paths, so .../api/v1 + /v1/... would become /api/v1/v1/... and 404.
TOKENGUARD_PROVIDER_ROUTES=
TOKENGUARD_TOKENIZER_MODEL=gpt-4
# Optional bootstrap / offline seed. Live catalog lives in Turso model_prices.
# Prefer OpenRouter sync over hand-editing this file for every new model.
TOKENGUARD_PRICING_FILE=pricing.json
# Pull live OpenRouter model rates into Turso on boot (default true when unset).
# Set false only for fully offline / file-only catalogs.
TOKENGUARD_PRICING_SYNC_OPENROUTER=true
# Background refresh interval (Go duration). Default 6h. Use 0 for boot-only.
TOKENGUARD_PRICING_SYNC_INTERVAL=6h
# Optional override for OpenRouter models API (tests / private mirrors).
# TOKENGUARD_OPENROUTER_MODELS_URL=https://openrouter.ai/api/v1/models
TOKENGUARD_GUARD_ENABLED=true
TOKENGUARD_MGMT_ENABLED=false
TOKENGUARD_ADMIN_SECRET=

# Product portal APIs (UI lives in web/ Next.js).
TOKENGUARD_PORTAL_ENABLED=false
TOKENGUARD_PORTAL_BASE_URL=
# Next.js product UI URL. When set, GET /portal redirects here.
TOKENGUARD_PORTAL_APP_URL=http://localhost:3000/portal
TOKENGUARD_PORTAL_CORS_ORIGINS=http://localhost:3000
TOKENGUARD_PORTAL_DEFAULT_BUDGET_USD=5
TOKENGUARD_PORTAL_MAX_KEYS=5
TOKENGUARD_PORTAL_SESSION_TTL_HOURS=720
TOKENGUARD_PORTAL_SECURE_COOKIES=true

TOKENGUARD_CLERK_PUBLISHABLE_KEY=
TOKENGUARD_CLERK_SECRET_KEY=
# Or: CLERK_PUBLISHABLE_KEY / CLERK_SECRET_KEY

# Local API tests only (cookie login without Clerk). Never on public hosts.
TOKENGUARD_PORTAL_DEV_LOGIN=false

TOKENGUARD_DEFAULT_MAX_OUTPUT_TOKENS=4096
TOKENGUARD_MAX_REQUEST_BYTES=4194304
TOKENGUARD_READ_HEADER_TIMEOUT_MS=2000
TOKENGUARD_SHUTDOWN_TIMEOUT_MS=5000

# Optional local cache for tiktoken dictionaries.
TIKTOKEN_CACHE_DIR=.tiktoken-cache

# Optional tuning defaults.
TOKENGUARD_DB_MAX_OPEN_CONNS=4
TOKENGUARD_REDIS_TIMEOUT_MS=750
TOKENGUARD_LOOP_TTL_SECONDS=180
TOKENGUARD_LOOP_THRESHOLD=3
TOKENGUARD_LOOP_KEY_PREFIX=tokenguard:loop
