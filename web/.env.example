# =============================================================================
# TokenGuard web (Next.js) — copy to .env.local
# Never put TOKENGUARD_ADMIN_SECRET or tg_ keys here.
# Go API secrets live in the repo-root .env
# =============================================================================

NEXT_PUBLIC_GITHUB_URL=https://github.com/anirudh-xdev/token_guard

# Go API origin (proxy + /portal/api/* + /mgmt/*). No trailing slash.
NEXT_PUBLIC_TOKENGUARD_API_URL=http://127.0.0.1:8080

# Optional: marketing “live demo” CTAs (usually same as API URL in local dev).
# NEXT_PUBLIC_DEMO_URL=http://127.0.0.1:8080

# Clerk — same application as TOKENGUARD_CLERK_SECRET_KEY on the Go API.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
