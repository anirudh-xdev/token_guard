# Public frontend — never put TOKENGUARD_ADMIN_SECRET or tg_ keys here.

NEXT_PUBLIC_GITHUB_URL=https://github.com/anirudh-xdev/token_guard

# Go TokenGuard API (proxy + /portal/api/*). No trailing slash.
NEXT_PUBLIC_TOKENGUARD_API_URL=http://127.0.0.1:8080

# Optional alias used by marketing CTAs
# NEXT_PUBLIC_DEMO_URL=http://127.0.0.1:8080

# Clerk (same application as the Go API secret)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
